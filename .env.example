# Copy to .env or export in shell. Never commit real values.
# Used by application-dev.properties / supabase / test via ${DB_*} placeholders.

# Local Postgres (default for dev)
DB_URL=jdbc:postgresql://localhost:5432/inventory_db?sslmode=disable
DB_USERNAME=inventory
DB_PASSWORD=changeme

# Supabase Transaction Pooler example (profile: supabase):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<supabase-password>

# JWT (must be >=32 chars, prod has no default)
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_EXPIRATION_MINUTES=720

# Test DB (isolated)
TEST_DB_URL=jdbc:postgresql://localhost:5432/inventory_test?sslmode=disable
TEST_DB_USERNAME=inventory
TEST_DB_PASSWORD=changeme

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
